turn(0,h.jsx)("svg",{width:"24",height:"24",fill:"none",viewBox:"0 0 24 24",...e,"data-fpl-icon-size":"24",children:(0,h.jsx)("path",{fill:"var(--fpl-icon-color, var(--color-icon))",d:"M17.5 17a.5.5 0 0 1 0 1h-11a.5.5 0 0 1 0-1zM13 5a1 1 0 0 1 .995.897L14 6v1.99q0 .01.01.01H16l.102.005a1 1 0 0 1 .893.892L17 9v6.5a.5.5 0 0 1-1 0V9.01a.01.01 0 0 0-.01-.01h-1.98a.01.01 0 0 0-.01.01v6.49a.5.5 0 0 1-1 0V6.01a.01.01 0 0 0-.01-.01h-1.98a.01.01 0 0 0-.01.01v9.49a.5.5 0 0 1-1 0v-4.49a.01.01 0 0 0-.01-.01H8.01a.01.01 0 0 0-.01.01v4.49a.5.5 0 0 1-1 0V11a1 1 0 0 1 1-1h1.99a.01.01 0 0 0 .01-.01V6a1 1 0 0 1 1-1z"})})});var ma=a(54649),mi=a(238079),mn=a(381519);let ml=[{id:"website",label:(0,v.t)("figmake.empty_state.use_case.website"),icon:(0,h.jsx)(x9.o,{}),prompts:[{id:"website_fieldwork_landing",prompt:`Build a landing page for "FieldWork," a high-utility documentation tool for architects and contractors. The aesthetic must be ultra-minimalist, high-precision, and "industrial-premium"\u2014think Dieter Rams meets a modern architectural blueprint.

\u2014

Core Design System:
\u2022 Palette: Stark whites, deep "Blueprint" charcoals, and light concrete greys. Use a single Vivid Safety Orange (#FF5733) exclusively for primary CTAs and critical status indicators.
\u2022 Typography: A robust, sophisticated sans-serif (e.g., Inter or Geist) using tight tracking and generous leading. Use monospaced fonts for metadata and "Work in Progress" labels to emphasize the technical nature of the tool.
\u2022 Grid: A rigorous, visible Swiss-style grid. Use thin 1px borders to separate sections, giving the app a "sturdy" and structured feel.

Section Specifications:
\u2022 Hero: A bold, left-aligned headline in heavy weights. The product screenshot should be a "floating" browser window with a subtle, sharp drop shadow, showing a clean report dashboard.
\u2022 Process Section: A horizontal three-step layout using "Card" components. Each card should feature a high-fidelity icon (Site Photo \u2192 Note \u2192 Report).
\u2022 The Transformation: A side-by-side "Input vs. Output" comparison. On the left, a raw, messy stack of digital "Polaroids" and scribbled notes; on the right, a perfectly aligned, PDF-style progress report.
\u2022 Social Proof: Minimalist blockquotes. No headshots\u2014just the quote in a larger font size, followed by the person's name and firm in a small, all-caps monospaced font.
\u2022 Pricing: A single, centered "Simple Tier" card. No "Most Popular" badges or flashy gradients\u2014just clear, bold pricing and a checklist of features.

Technical Execution: Use Tailwind CSS for layout. Ensure 80px+ of vertical whitespace between sections. Avoid all rounded corners (radius: 0px) to maintain a "site-built" architectural edge. Use subtle CSS transitions on hover, but no bouncy animations.`,image:"8fcad39013e77c5b6b11f7d12cbbea5e6a1ef958"},{id:"website_hospitality_portfolio",prompt:'Build a high-end portfolio for a boutique brand studio specializing in hospitality (restaurants, bakeries, wine shops). The aesthetic is radically minimal, tactile, and editorial, favoring "quiet luxury" over digital trends.\n\n\u2014\n\nCore Visual Principles:\n\u2022 Typography: Use a sophisticated pairing of a tight, Swiss-style neo-grotesque for UI and a high-contrast, sharp serif for headers (e.g. Cormorant Garamond).\n\u2022 Grid & Layout: Use an asymmetrical, "broken" CSS grid with generous whitespace (aim for 120px+ margins). Nothing should feel crowded.\n\u2022 Materiality: Implement subtle "paper" textures and grain overlays. Use image treatments like soft drop shadows or slight rotations to make mockups feel like they are sitting on a physical desk.\n\u2022 Motion: Use "purposeful friction"\u2014slow, eased transforms and buttery-smooth page transitions (e.g., Framer Motion or GSAP).\n\nArchitecture:\n1. Homepage: A curated, staggered masonry grid of selected work that begins immediately below the typographic header. Each project card should have a small, elegant label in 9pt mono font.\n2. Case Study: A deep-dive layout. Mix high-fidelity photography with "process" elements: scanned napkin sketches, raw typography specimens, and zoomed-in texture shots of paper stocks or signage materials.\n3. Studio/Services: Clean, text-heavy sections using monochromatic tones. Focus on "The Process" described in a single, well-composed column with a line-length capped at 65 characters.\n4. Contact: A brutalist, ultra-simple footer with a large-type email link and a minimalist location stamp.\n\nTechnical Spec:\n\u2022 Use a muted, "gallery-white" or "warm-linen" background (#F9F9F7).\n\u2022 Ensure every image uses object-fit: cover with custom aspect ratios (3:4, 16:9, and 1:1 mixed) to create a rhythmic, editorial flow.\n\u2022 Implement a custom cursor that changes to "View" on image hover.',image:"059abdaa6b28862595cf886cf10116a63e0154f9"},{id:"website_grocery_dashboard",prompt:'Build a high-end, minimalist web dashboard for a neighborhood grocery chain using a "Sophisticated Industrial" aesthetic. The design must prioritize utility and legibility for busy store teams while maintaining a premium, modern feel.\n\n\u2014\n\nVisual Language & Style\n\u2022 Minimalist Palette: Use a clean "Paper White" background (#F9FAFB) with "Obsidian" text (#111827). Use a single accent color\u2014like a Deep Forest Green (#064E3B) or International Klein Blue\u2014strictly for primary actions and data highlights.\n\u2022 Typography: Use a robust, highly-readable Sans-Serif stack (e.g., Inter, Geist, or SF Pro). Use tabular-spaced fonts for numerical data to ensure columns align perfectly.\n\u2022 The "Sturdy" Aesthetic: Use subtle, 1px borders (#E5E7EB) instead of heavy drop shadows. Apply a generous 8px or 12px border radius to cards to soften the industrial feel.\n\u2022 Negative Space: Implement aggressive padding (minimum 24px) within cards to prevent data density from feeling cluttered.\n\nLayout Architecture\n\u2022 Executive Header: A slim top bar with a store-switcher dropdown and a "Last Updated" timestamp in a small, muted gray font.\n\u2022 KPI Cards (The "At-a-Glance" Row): Four border-only cards showing Sales, Spoilage %, Low Stock Alerts, and Daily Target. Use large, bold numerals and tiny, micro-copy trend indicators (e.g., "+2% vs yesterday").\n\u2022 Main Stage (The Trend Chart): A wide, minimalist line or area chart showing 7-day performance. Remove unnecessary grid lines; use a single, smooth stroke for the data line.\n\u2022 Action Table (The "Critical Path"): A clean list of inventory items needing attention. Use "Status Pills" with muted background colors (e.g., a soft peach for "Expiring Soon," not a jarring red).\n\u2022 Utility Sidebar: A collapsible right-hand panel for "Store Notes" and "Quick Actions," using a slightly darker off-white background to create depth without using shadows.\n\nDevelopment Vibe\nFocus on high-density information with low-visual noise. The interface should feel like a high-end physical tool\u2014functional, durable, and refined. Ensure all interactive elements have a subtle scale-down effect on click to provide tactile feedback.',image:"b07f6e967a57b7c97867a0fe35059b7cc60c8c1b"},{id:"website_ecommerce",prompt:`Build a high-end e-commerce experience for a boutique city-culture shop using React, Tailwind CSS, and Framer Motion. The aesthetic is "Modern Archivist"\u2014blending the refined editorial feel of a premium coffee table book with the playful, fluid interactions of a modern digital studio.

\u2014

Visual DNA
\u2022 Palette: Deep ink blacks, warm gallery whites (#F9F8F7), and a single "curator" accent color (like a burnt ochre or International Klein Blue).
\u2022 Typography: A sophisticated pairing of a high-contrast serif for headings (e.g., editorial-style) and a wide-tracked, "quiet" sans-serif for UI elements.
\u2022 Feel: Tactile, airy, and rhythmic. Every element should feel like it was placed by a human hand.

Key Components to Build
\u2022 The "Hero Archive": A homepage header featuring a striking oversized image. Use a smooth parallax effect or a "reveal" animation on scroll that mimics opening a fresh book.
\u2022 The Grid: A highly browsable product feed using asymmetrical layouts. Products shouldn't just be boxes; they should have subtle drop shadows that feel like paper weight and high-res hover zooms.
\u2022 The Product Stage: A product page that treats the item like an artifact. Include an elegant "Edition Details" table and a gallery that uses a horizontal "filmstrip" scroll.
\u2022 The "Ghost" Cart: A slide-over or micro-modal cart that appears with a buttery-smooth spring animation. The "Quick Add" button should have a tactile haptic-inspired micro-interaction (e.g., a slight scale-down on click).

Tech Requirements
\u2022 Animations: Use Framer Motion for staggered entrance animations (fade-in-up) and layout transitions between pages to maintain a "single-piece" feel.
\u2022 Details: Implement "soft-loading" image skeletons and custom cursor interactions over image galleries to indicate "Drag" or "View."
\u2022 Craft: Ensure the spacing is generous; let the high-fidelity photography of the maps and art prints breathe.`,image:"befb248ddadc64218c96409f673b4fa3f0b670df"},{id:"website_retail_magazine",prompt:`Create a high-end, minimalist React/Tailwind web application for a niche independent retail magazine. The aesthetic is "Modern Archive"\u2014think Kinfolk meets Readymag. Use a sophisticated, high-contrast typography pairing (a needle-sharp Serif for headings and a spacious, neutral Sans-Serif for body text).

\u2014

Visual DNA:
\u2022 Palette: Paper-white (#F9F9F7), charcoal-ink (#1A1A1A), and a single "gallery-label" accent like a muted Ochre or Sage.
\u2022 Grid: A generous, breathable Swiss-style grid with intentional asymmetrical whitespace.
\u2022 Atmosphere: Calm, smart, and premium. No shadows, no gradients\u2014just crisp borders (0.5px) and perfect kerning.

The Homepage:
\u2022 The Hero: A full-bleed or large-frame "Hero Portrait" of a retail space. The headline should be oversized and elegant, overlapping the image slightly to create depth.
\u2022 The Navigation: A "floating" or sticky minimal header with a discreet category bar (Bookstores, Wine Bars, Floral, Hardware, Provisions).
\u2022 The Feed: A refined grid where each card uses "slow-hover" image scaling. Include a "Curator's Note" section for the author that feels like a hand-signed letter.
\u2022 Newsletter: A low-impact, wide-row signup at the footer. Use copy like "Notes on the Local" instead of "Subscribe".

The Article Experience:
\u2022 Reading Rhythm: Center-aligned text column with a 65\u201375 character line length for maximum legibility.

Editorial Elements:
\u2022 Pull Quotes: Large, italicized serif text that breaks the grid.
\u2022 Photography: Mix of full-width "mood" shots and small, captioned "detail" shots tucked into the text.
\u2022 Transitions: Silky, ease-in-out page fades to maintain a "slow-living" pace.

Deliver clean, component-based code that prioritizes whitespace as a functional element.`,image:"8fd070e0c644d025b84b7b087da50e2934d69ed8"}]},{id:"mobile_app",label:(0,v.t)("figmake.empty_state.use_case.mobile_app"),icon:(0,h.jsx)(me.u,{}),prompts:[{id:"app_social_feed",prompt:'Create a high-fidelity, minimal, and ultra-refined social feed app for interior designers and set stylists using a "Gallery-First" aesthetic.\n\n\u2014\n\nDesign Philosophy\n\u2022 Minimalism as a Canvas: Use a monochrome palette (stark whites, soft ebonies, and warm grays) so the vibrant colors of material swatches and room layouts provide the primary visual interest.\n\u2022 Architectural Spacing: Prioritize generous whitespace and asymmetric layouts to mirror high-end editorial magazines like Kinfolk or Cereal.\n\u2022 Fluid Motion: Implement subtle, physics-based micro-interactions for likes (lightweight haptic pops) and smooth shared-element transitions between the feed and detail views.\n\nKey Visual Components\n1. The Masonry Feed: Build a staggered, multi-column image feed that handles varying aspect ratios (16:9 for wide rooms, 4:5 for vertical mood boards). Use soft-drop shadows and rounded corners (8-12px) to give images a tactile, "printed" feel.\n2. Immersive Detail View: A post view where the image takes up the top 60% of the screen. Overlaid on the image are "hotspots" or "tags" for sourcing finds. Below, use a clean, serif typeface for titles and a high-contrast sans-serif for metadata.\n3. The "Material Palette" Composer: A post-creation flow that looks like a blank drafting table. Allow users to "stack" photos like physical Polaroids and add digital sticky notes for material pairings.\n4. Curated Filters: A horizontal-scrolling chip bar at the top using lowercase, spaced-out typography (e.g., living room, velvets, brutalist).\n5. Profile Highlights: Use circular "stories" or "mood-bubbles" to categorize saved references into aesthetic themes.\n\nTechnical Vibe\nUse a modern stack (e.g., React Native/SwiftUI) focusing on Image Treatment: implement a blur-up loading strategy with dominant-color placeholders. Ensure the UI remains nearly invisible\u2014no heavy borders, no cluttered icons\u2014just crisp iconography and beautiful photography.',image:"8e91a22b84a88189f1c16acaf652c4d7909c404b"},{id:"app_task_management",prompt:'Build a high-end, minimalist task management interface for a retail design team, emphasizing architectural precision and "white space" luxury. The UI should feel like a digital extension of a physical design studio\u2014calm, organized, and tactically functional.\n\n\u2014\n\nVisual Aesthetic:\n\u2022 Palette: Monochromatic base (stark whites, soft greys, "Architectural Black") with a single high-contrast accent color (e.g., International Orange or Electric Cobalt) used strictly for action items and urgent alerts.\n\u2022 Typography: Professional sans-serif (Inter or SF Pro) with generous kerning and clear hierarchical scaling.\n\u2022 Elements: Thin 1px borders, subtle drop shadows, and glassmorphism effects for detail panels to maintain depth without clutter.\n\nCore Views & Components:\n1. Portfolio Dashboard: A high-level grid of store openings. Each "card" features a hero image of the floor plan or facade, a minimalist progress bar, and a "Health" indicator (e.g., a simple colored dot for status).\n2. Phase-Grouped Task Board: A horizontal Kanban-style layout categorized by project stages: Permitting, Shell & Core, Fixtures, Signage, Final Punch List. Tasks are clean tiles showing only the title, a tiny avatar for ownership, and a deadline.\n3. The "Priority Pulse" Timeline: A condensed Gantt chart at the top of the screen that highlights critical path milestones. Use connecting lines that feel like drafting ink.\n4. Integrated Detail Panel: A slide-out "Drawer" for specific tasks. It must elegantly host a file gallery for floor plans, a nested checklist for tiny "Last-Minute Fixes," and a threaded comment section that looks like a clean chat transcript.\n\nFunctional Cues:\n\u2022 Urgency Handling: Tasks past due or blocking others should subtly glow or use the accent color to draw the eye immediately.\n\u2022 Density Toggle: A "Macro/Micro" switch that collapses the view to show only big milestones or expands it to reveal every granular detail and sub-task.\n\nThe Goal:\nCreate a layout that makes a complex multi-store rollout feel as orderly as a curated gallery. The interface should disappear, leaving only the work and the next logical step visible.',image:"e1c60f6ad05a22ed495df211af87d2a366746aac"},{id:"app_fitness_tracker",prompt:`Build a high-end, minimal fitness and habit tracker tailored for first-time long-distance hikers. The aesthetic should be "Functional Zen"\u2014prioritizing extreme clarity, generous white space, and a sophisticated, soft-utility palette (think Sage Green, Warm Stone, and Slate).

\u2014

Core UI Principles:
\u2022 Typography: Use a clean, modern sans-serif (like Inter or Geist) with intentional tracking and purposeful hierarchy.
\u2022 The Card System: Utilize soft-shadowed or subtly bordered cards to group "Walks," "Strength," and "Gear Prep." Each card should feel tactile and "breathable."
\u2022 Progress Visualization: Replace aggressive "gamified" rings with elegant, thin-stroke progress lines or soft "organic" shapes that fill as tasks are completed.
\u2022 The "Trail Prep" Distinctness: Design a dedicated "Gear & Route" section using a refined checklist UI\u2014incorporate small, high-quality iconography for gear items (boots, packs, filters) to make it feel like a professional expedition log rather than a gym app.

Functional Elements:
\u2022 Daily Check-in: A welcoming, top-of-screen greeting that summarizes the day's "Steady Steps" (Water, Sleep, Activity).
\u2022 Tactile Logging: Interactive, oversized buttons for logging training sessions and gear tests that provide subtle haptic-style visual feedback.
\u2022 Navigation: A dead-simple bottom dock focusing on: Today, The Plan, Gear/Trail, and Progress.

The "Vibe":
The app must feel capable but quiet. Avoid loud reds or intense neon greens. Use a "Bright/Light" mode by default that feels like a crisp morning on the trail. The tone is a "calm mentor"\u2014encouraging, steady, and meticulously organized.`,image:"dd06af508cb3b01ca6512bfa057e398bfc8ce5ec"},{id:"app_messaging",prompt:'Build a high-end, minimalist mobile messaging interface for home renovation collaboration using a "Refined Utility" aesthetic. The UI should prioritize typography, whitespace, and structural hierarchy over decorative elements, feeling more like a bespoke studio tool than a social media app.\n\n\u2014\n\nVisual Language & System\n\u2022 Palette: A "Gallery Minimalist" scheme. Use a foundation of Stark White (#FFFFFF) and Soft Gray (#F5F5F7) for surfaces. Primary text in deep Charcoal (#1A1A1A) with secondary metadata in a muted Slate (#71717A). Use a single, sophisticated accent color\u2014like a muted Sage Green or Deep Petrol Blue\u2014exclusively for active states and primary calls to action.\n\u2022 Typography: Use a variable Sans-Serif (like Inter or San Francisco) with generous tracking for headers. Use bold, oversized "Workstream" titles to anchor the navigation.\n\u2022 Layout: Implement a "Card-in-Card" architecture. Group messages and updates into distinct blocks with subtle 1px borders or soft, natural drop shadows to define boundaries without adding visual noise.\n\nCore Components\n\u2022 The Workstream Switcher: A horizontal, pill-shaped scroll at the top (Kitchen, Lighting, Built-ins) that uses high-contrast active states to show location.\n\u2022 The Feed: A unified timeline where "Status Cards" (Schedule Changes, Deliveries) are visually distinct from "Chat Bubbles." Status cards should use a condensed, tabular layout for quick scanning of dates and quantities.\n\u2022 Decision Pins: A persistent, collapsible header "tray" that houses "Outstanding Approvals." Use a simple "Approve / Decline" toggle with haptic-ready, polished button states.\n\u2022 Media Handling: Photos should be displayed in a clean grid with rounded corners (r=12px). Marked-up images should show a subtle "Edit" badge.\n\nInteractions & Vibe\n\u2022 State Changes: Use micro-interactions for "Read" states\u2014avoid checkmarks; use a subtle text fade or a tiny, elegant dot.\n\u2022 Feel: The app should feel "Architectural"\u2014stable, organized, and premium. Every element must have a functional reason to exist, ensuring the homeowner feels in control and the contractor feels efficient.',image:"c22358f57074bc6a40e62089b3644702c972f91c"},{id:"app_freelance_finance",prompt:"Create a high-fidelity UI design for a minimalist freelance finance app. The aesthetic is 'Studio Quiet': expansive white space, a sophisticated grayscale palette with a single accent color (like International Klein Blue or Sage Green), and impeccable Swiss typography (e.g., Neue Haas Grotesk).\n\n\u2014\n\nThe dashboard features a soft-shadowed card for 'Monthly Runway' that feels reassuring rather than stressful. Use ultra-thin line iconography and 'ghost' buttons to maintain a decluttered feel. Data visualizations should be elegant and sparse\u2014think subtle area charts with low-opacity gradients and donut charts with generous inner tracking.\n\nKey elements to include:\n1. The Pulse: A delicate monthly trend line showing the ebb and flow of project income.\n2. The Tax Nest: A clear, dedicated section for 'Stashed' tax funds that feels like a safe harbor.\n3. Project Cards: A list of active invoices titled by client name, using muted status badges (e.g., 'Sent', 'Settled') and monospaced digits for currency to imply precision.\n\nThe overall vibe is tactile and premium, resembling a high-end physical planner or a boutique design studio's internal tool. No clutter, no loud alerts\u2014just clarity and calm.",image:"303cde5268877263a121e4680216df2c92fac2d5"}]},{id:"visualization",label:(0,v.t)("figmake.empty_state.use_case.visualization"),icon:(0,h.jsx)(mt,{}),prompts:[{id:"viz_cinema_analytics",prompt:'Build a high-end analytics dashboard using a minimalist, cinematic noir aesthetic. The UI should prioritize deep blacks, slate grays, and "projectionist white" text, using vibrant neon-amber or celluloid-green as the single accent color for data visualization to evoke the glow of a theater screen in the dark.\n\n\u2014\n\nLayout & Architecture:\n\u2022 Top-Level Metrics: Four clean, borderless cards displaying Ticket Sales, Concession Revenue, Seat Occupancy, and Total Attendance. Use a high-contrast, monospaced font for the numbers to give it a "technical readout" feel.\n\u2022 Weekly Sales Chart: A sleek, smoothed area chart with a subtle gradient fill. Use thin grid lines and avoid bulky axes.\n\u2022 Theater Breakdown: A vertical bar chart or a clean list with micro-sparklines representing the "pulse" of each location.\n\u2022 Top Films Section: A horizontal scroll or grid featuring high-resolution film stills dimmed to 40% opacity, with performance data overlaid in crisp typography.\n\u2022 High-Occupancy Table: A "Hot Screenings" table with a minimalist "Fill Level" indicator (a thin progress bar or a simple percentage) for shows nearing 100% capacity.\n\nAesthetic Directives:\n\u2022 Typography: Use a sophisticated sans-serif (like Inter or Geist) paired with a monospaced font (like JetBrains Mono) for data points.\n\u2022 Contrast: High contrast but easy on the eyes. Use soft shadows and subtle glassmorphism (backdrop-blur) instead of heavy borders to define sections.\n\u2022 Interactions: Hover states should feel buttery and cinematic\u2014subtle scaling of cards or a soft glow on table rows.\n\u2022 Filters: Implement a slim, "fixed-to-top" filter bar for Date, City, and Film that uses understated dropdowns with no heavy chrome.\n\nThe Vibe: Like a high-tech mission control for a modern film studio. Sharp, sophisticated, and quiet, allowing the data to be the protagonist.',image:"4bbcac202f1527eb61b74a5ef6df5cefccc895ec"},{id:"viz_energy_dashboard",prompt:"Create a high-fidelity UI for a premium home energy management dashboard, focusing on a centerpiece interactive time-series chart. The aesthetic is 'Functional Minimalism': an ultra-clean, spacious layout inspired by Braun industrial design and modern Swiss typography.\n\n\u2014\n\nVisual Language:\n\u2022 Palette: A sophisticated monochromatic base (soft whites, cool grays) with high-contrast accent colors for data\u2014think Electric Cobalt for usage and Sage Green for cost.\n\u2022 Typography: Use a crisp, variable sans-serif (like Inter or San Francisco) with generous tracking and strict optical alignment.\n\u2022 Atmosphere: Soft, diffused shadows and subtle glassmorphism to create depth without clutter.\n\nChart Features:\n\u2022 The Main View: A dual-mode area chart (Usage in kWh vs. Cost in USD) with a smooth, tensioned spline curve. Use a refined gradient fill that breathes.\n\u2022 Interactivity: A vertical needle-thin scrubber for tooltips. The tooltip itself is a floating, minimalist pill showing precise data points with micro-interactions.\n\u2022 Anomaly Detection: Minimalist markers (a singular, pulsing dot or a subtle vertical highlight) to indicate energy spikes.\n\u2022 Controls: A segmented 'Ghost' button bar for time-range switching (D, W, M, Y) and a sleek, tactile range slider at the bottom.\n\nComposition:\nKeep the chart as the hero element with ample negative space. The surrounding interface should feel invisible yet intuitive, ensuring the data is the only thing that matters. Render with the clarity of a high-end Retina display.",image:"a3b6228c82ca4cb7447d8968cd79bbbadd6c55e6"},{id:"viz_heatmap",prompt:'Build a high-end, React-based heatmap dashboard for rehearsal room analytics using a "Sophisticated Minimalist" aesthetic.\n\n\u2014\n\nVisual Identity:\n\u2022 Palette: Use a refined, low-contrast "Ink & Paper" theme. A background of off-white (#F9F9F9) or deep charcoal (#121212).\n\u2022 Heatmap Cells: Instead of jarring "stoplight" colors, use a monochromatic gradient (e.g., Soft Sage to Deep Forest or Muted Clay to Slate). Apply a subtle border-radius: 2px to cells and a gap: 3px to create a rhythmic, woven texture.\n\u2022 Typography: Use a premium sans-serif like Inter or Geist. Keep labels small (10-12px) with generous letter spacing to maintain a "gallery" feel.\n\nLayout & Components:\n\u2022 The Grid: The heatmap should be the hero, using a flex-grow layout. Use CSS Subgrid or Grid to align day labels perfectly with the cell rows.\n\u2022 Summary Panels: Place 3-4 "Stats-at-a-Glance" cards to the right. Use thin 1px borders and no drop shadows. Each card should feature a single bold metric (e.g., "Peak: Tuesday 4PM") and a micro-sparkline.\n\nInteractions:\n\u2022 Hover: Implement a soft scale effect on the active cell and a floating, glassmorphism tooltip showing the exact count and room name.\n\u2022 Filters: Use pill-shaped toggle buttons with a subtle "active" state\u2014no heavy shadows, just a slight shift in background value.\n\nCode Requirements:\n\u2022 Use Tailwind CSS for styling and Framer Motion for buttery-smooth entry transitions.\n\u2022 Ensure the layout is responsive, gracefully collapsing the summary panels into a top row on smaller viewports.\n\u2022 The overall vibe should feel less like a "data tool" and more like a high-end architectural blueprint or a boutique booking platform.',image:"d29b2505ffefd89abb6b383ce4763c09fe036ed2"},{id:"viz_sankey",prompt:'Build a high-end, immersive "Opportunity Flow" Sankey visualization for e-commerce traffic. The aesthetic must be hyper-minimal, sophisticated, and data-dense, with a premium "Command Center" feel.\n\n\u2014\n\nVisual Architecture\n\u2022 The Flow: Use organic, fluid sigmoid paths (S-curves) to connect stages: Homepage \u2192 Category \u2192 Product \u2192 Cart \u2192 Checkout.\n\u2022 The Physics: Path thickness must dynamically scale based on traffic volume. Use vibrant, glowing neon gradients for successful transitions (e.g., electric cyan to emerald green) and muted, deepening violets or magentas for drop-offs moving downward.\n\u2022 The Nodes: Separate stages of the flow with thin vertical bars rather than bulky boxes. Ensure ample negative space between flows to prevent visual clutter.\n\nInterface & Interaction\n\u2022 Typography: Use a clean, wide-tracked sans-serif (like Inter or Geist) for high readability. Large, hero-style summary metrics at the top (Total Traffic vs. Conversions) with a subtle "delta" indicator for net change.\n\u2022 The Detail Panel: Implement a sleek, semi-transparent glassmorphism (frosted blur) tooltip that appears on hover. It should show a donut chart for conversion percentage, raw counts, and a specific "Step Health" metric.\n\u2022 Atmosphere: Add a faint, dotted horizon line or a subtle grid floor to provide a sense of scale and grounding.\n\u2022 Refinement: No borders, no heavy shadows\u2014only inner glows and light-leaks. The UI should feel like a "dark mode" financial terminal designed by a luxury design studio. Clear, high-contrast labeling with minimalist filter buttons in the top-left.',image:"8e55bbb6f8bee3712b6169629e3ef6566c905d03"},{id:"viz_network_graph",prompt:'Build a museum provenance network graph using React, D3.js, and Tailwind CSS that prioritizes high-end editorial design over standard data viz. The aesthetic should be "Archival Minimalist"\u2014think Swiss typography, generous whitespace, and a monochromatic palette with a single high-contrast accent color (e.g., International Klein Blue or Crimson).\n\n\u2014\n\nThe Graph Canvas\n\u2022 Nodes: Use subtle, geometric shapes. Artists are small filled circles, venues are outlined squares, and exhibitions are delicate crosses. Node size (weight) scales with connection density. On hover, nodes should "bloom" slightly with a soft glow or a ring.\n\u2022 Edges: Use thin, hairline strokes (0.5px) with a 0.2 opacity. When a node is selected, its connected edges should animate into a solid, saturated state using a variable-width "tapered" stroke.\n\u2022 Physics: Implement a highly dampened force-directed layout that feels intentional and "heavy" rather than bouncy or erratic.\n\nThe Interface Shell\n\u2022 Sidebar (The Dossier): A fixed right-hand panel using a serif font for headers (e.g., Cormorant Garamond) and a monospace font for metadata (e.g., JetBrains Mono). Include a "Connections" list that allows deep-linking to other nodes.\n\u2022 Top Navigation: A floating, glassmorphism header containing a sleek range slider for "Year Range" and a segmented control for "Category" (Art/Space/People).\n\u2022 Micro-interactions: Add a custom cursor that changes from a "crosshair" on the canvas to a "pointer" on nodes. Use Framer Motion for panel transitions to ensure the UI feels fluid and premium.\n\nTechnical Polish\n\u2022 Implement a "Focus Mode" where non-selected nodes fade to 0.05 opacity, turning the graph into a clean, highlighted path.\n\u2022 Ensure all labels use text-rendering: optimizeLegibility and only appear at specific zoom levels to prevent visual clutter.',image:"39d857d2e67457b1506f459c1ef9ba3ba54d4b3d"}]},{id:"component",label:(0,v.t)("figmake.empty_state.use_case.component"),icon:(0,h.jsx)(ma.S,{}),prompts:[{id:"component_buy_button",prompt:'Create a React component using Tailwind CSS and Framer Motion for a "Buy Now" button that centers on a "Desert Dusk" aesthetic.\n\n\u2014\n\nThe Environment: Design a ultra-minimal checkout card (max-width: 400px) with a soft #F9F7F2 background. Include one line of elegant serif typography for a product name ("The Sculpted Vase") and a muted price ($240) to provide context.\n\nThe Star: The Button\n\u2022 Color & Shape: A deep, desaturated terracotta (#AC5839) pill-shaped button with generous internal padding (e.g., py-5 px-12).\n\u2022 Typography: "Confirm Order" in a tiny, tracked-out sans-serif (uppercase, 11px) in ivory.\n\u2022 Default State: A subtle, soft-weighted drop shadow that feels like the button is hovering 2mm off the page.\n\nThe Interaction Logic (The "Vibe"):\n\u2022 Hover: The button should subtly "inflate" (scale: 1.02) while the background color shifts slightly warmer. The cursor should feel magnetic.\n\u2022 Pressed: A tactile "squish" effect (scale: 0.96) with the shadow flattening instantly to simulate physical depth.\n\u2022 Loading State: Upon click, the text fades out upward, and a single, elegant white dot performs a slow, rhythmic pulse or a "loading bar" that traces the outer border of the pill shape once.\n\u2022 Success: A brief, haptic-like shimmy or a soft color flash to forest green before settling back.\n\nTechnical Focus: Use layoutId for smooth transitions between states. Avoid generic loaders; focus on refined, bespoke motion that feels "expensive" and intentional. Tight composition only\u2014no sidebars or headers.',image:"bc1076fec33a048cdf25b9f7f7077f03f0d9cc21"},{id:"component_reservation_modal",prompt:`Develop a high-fidelity React component with Tailwind CSS (or pure CSS) for a single-screen "Limited Drop" reservation modal.

\u2014

Visual DNA: Minimalist Luxury & Spatial Depth
\u2022 The Backdrop: A blurred, desaturated product collection view (z-0). Use a heavy backdrop-blur-xl and a darkened overlay to push the background into the distance, making the modal the absolute protagonist.
\u2022 The Modal (The Hero): A floating, centered container with a subtle 1px border (frosted glass or deep charcoal). Apply a multi-layered box shadow to create a physical sense of elevation:
\u2022 Shadow = sm(0, 2, 4) + md(0, 12, 24) + lg(0, 45, 65)
\u2022 Typography: Use a high-contrast pairing\u2014an elegant, oversized Serif for the product title (e.g., Editorial New or Cormorant Garamond) and a tight, mono-spaced Sans for technical details (e.g., SF Mono or Inter).
\u2022 Palette: Restrained. Choose one "Signature" accent color (e.g., International Orange, Electric Cobalt, or Deep Forest) against a canvas of off-whites, greys, and blacks.

Interface Elements
\u2022 Imagery: A single, high-resolution product crop with a soft-focus shadow, breaking the internal grid slightly to create movement.
\u2022 Interaction: A refined "Quantity" stepper and a "Reserve" button that feels heavy and tactile\u2014high-contrast background with a micro-interaction on hover.
\u2022 Context: Minimal meta-data (e.g., "04/50 Remaining" in a small, pill-shaped badge).

The Goal: A "best-in-class" screenshot that looks like a frame from a high-end design studio's portfolio\u2014prioritizing white space, intentional alignment, and a "less but better" philosophy.`,image:"dfa6348112dc049d7d58958afbc0e4e5bc0af959"},{id:"component_dropdown_menu",prompt:`Create a high-fidelity product screenshot of a single, open dropdown menu within a premium editorial planning tool. The shot is tightly cropped, focusing on the tactile interaction of changing a story's status.

\u2014

The menu is the unmistakable centerpiece, floating over a fragment of a cream-colored story card. The UI features a sophisticated, warm palette\u2014think soft oatmeal backgrounds, deep charcoal typography, and accents of muted terracotta and sage.

Menu Details:
\u2022 Items: A vertical list: "Pitch," "In Progress," "Review" (with a nested chevron), and "Scheduled."
\u2022 Interaction: The "Review" row is in a hovered state, highlighted with a subtle, rounded clay-colored glow.
\u2022 Visuals: Tiny, minimalist geometric icons next to each label; a small nested submenu peeks out to the right.
\u2022 Aesthetic: Ultra-minimalist but high-taste. Soft organic shadows, generous whitespace (internal padding), and crisp 12px sans-serif typography.

Composition: Macro view, shallow depth of field on the background board elements, sharp focus on the glassmorphic menu texture and refined corner radiuses. No dashboards or sidebars\u2014just the soul of the interface in one precise, polished interaction. High-end "Linear" or "Rauno" design language.`,image:"ab544b505e5c5cfcfbe58e706809f0caf17a657d"},{id:"component_onboarding_tooltip",prompt:'Build a high-fidelity, minimal UI screen for a professional video editing app centered on a singular, "best-in-class" onboarding tooltip.\n\n\u2014\n\nThe Environment:\nThe background is a dark, cinematic timeline (hex: #0D0D0D) with a soft Gaussian blur. A singular, razor-sharp playhead in neon cyan (hex: #00F2FF) bisects the frame. To its right, a row of video clips glows with saturated gradients of deep purple, electric amber, and forest green. The rest of the editor\u2014levels, buttons, and menus\u2014is pushed into the periphery with low opacity (20%) to ensure zero visual noise.\n\nThe Focal Point:\nFloating precisely beside the playhead is a sophisticated, high-contrast tooltip.\n\u2022 Aesthetic: Ultra-minimalist with a slight glassmorphism effect (frosted acrylic), featuring a subtle 1px inner glow.\n\u2022 Content: A bold, sans-serif title "Precision Trim" followed by one elegant sentence: "Drag the edges of any clip to refine your timing with frame-accurate control."\n\u2022 Interaction: A single, pill-shaped "Got it" button with a haptic-inspired hover state.\n\nTechnical Feel:\nThe composition must feel intentional and architectural. Use generous whitespace (negative space), crisp 12px corner radii, and a tight, macro-lens perspective that makes the trim control feel like a premium physical instrument. Render with a focus on "Apple-tier" editorial UI design: clean, functional, and undeniably expensive.',image:"27432013443975b5282256aaf3a112ef2802c27c"},{id:"component_color_picker",prompt:'Develop a high-fidelity UI for a professional brand editor. The scene is a macro-shot focused entirely on a sophisticated, open color picker component.\n\n\u2014\n\nComposition & Layout\n\u2022 The Focal Point: The color picker should dominate the screen, occupying 70-80% of the composition. Center it with a slight, elegant offset to feel like a floating tactical tool.\n\u2022 The Backdrop: Show only a subtle, blurred "slice" of a canvas behind it\u2014perhaps a single high-end serif letterform or a geometric brand mark that live-updates as the cursor moves.\n\u2022 The Vibe: Precision-engineered, tactile, and minimalist. Think "instrument," not "menu."\n\nComponent Details\n\u2022 Color Field: A large, velvet-textured saturation/brightness square with a razor-thin circular reticle.\n\u2022 Controls:\n  - A buttery-smooth hue slider and an opacity slider with a micro-checkered transparency track.\n  - Clean, mono-spaced numeric inputs (Hex, RGB, and HSL) in a quiet, low-contrast typeface.\n  - A single row of "Recent Brand Colors" as soft-edged circular swatches.\n\u2022 Surface Treatment: Use a sophisticated glassmorphism effect\u2014ultra-fine background blur, a 0.5px white inner stroke for a "lit from above" edge, and a soft, multi-layered drop shadow (shadow-2xl style) to create depth.\n\nVisual Aesthetic\n\u2022 Palette: Deep charcoal or "off-white" paper UI surfaces to let the selected highlight color (e.g., a vibrant Electric Cobalt or Acid Lime) pop.\n\u2022 Interactive Cues: A "Live Preview" indicator where the chosen color glows slightly.\n\u2022 Refinement: Zero clutter. No header bars, no navigation, no "Save" buttons. Just the pure, functional beauty of color selection.',image:"fdefc54b0c0ccb77ab5d84c4af637accdd5d06c8"}]}];function ms(e,t){return t?(0,mn.k4)([...e.prompts],parseInt(t,10)):e.prompts}let mr=(0,eN.eU)(!1),mo=(0,eN.eU)(null),md=(0,eN.eU)(null);function mc({inputValue:e,setInputValue:t,chatMessagesNodeGuid:a,attachImage:i,onPromptChange:n}){let l=(0,iW.I0)(),s=(0,e3.TA)(),[r,o]=(0,g.useState)(null),[d,c]=(0,g.useSta